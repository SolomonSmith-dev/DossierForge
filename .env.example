# Flask session secret — set to a long random string in production
SECRET_KEY=change-me-in-production

# (Optional) Database URL. Defaults to SQLite under instance/. For Postgres:
# DATABASE_URL=postgresql://user:pass@localhost:5432/dossierforge
DATABASE_URL=

# (Optional) Directory for recon artifacts (defaults to instance/dossier_data)
DOSSIER_DATA_DIR=

# (Optional) Skip auto-applying Alembic migrations on startup (use when generating a new revision)
# SKIP_DB_UPGRADE=1
SKIP_DB_UPGRADE=

# (Optional) Run recon jobs inline instead of on the durable DB poller
# SCAN_JOBS_EAGER=true
SCAN_JOBS_EAGER=

# (Optional) Durable scan worker (polls ScanJob rows; reclaims orphans on start)
# SCAN_WORKER_ENABLED=false
# SCAN_WORKER_POLL_SECONDS=0.5
SCAN_WORKER_ENABLED=

# (Optional) GitHub personal access token for higher-rate GitHub API calls
GITHUB_TOKEN=

# (Optional) Absolute path to the nmap binary if it is not on your PATH
